<Project Sdk="Eto.Forms/2.13.0">

  <!--
    Set the BuildPlatform property to the Eto platform you wish to build for.
    The default is the platform you are building on.
    Valid values: Wpf, Windows, Mac64, MacOS, Gtk, Direct2D
  -->

  <PropertyGroup>
    <TargetFramework>net11.0-windows7.0</TargetFramework>
    <ApplicationIcon>ressources\icon.ico</ApplicationIcon>

  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ressources\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarBridger.SDK\StarBridger.SDK.csproj" />
  </ItemGroup>
	<Target Name="KeepIjwAssembliesOutOfBundle" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
		<ItemGroup>
			<ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'DirectWriteForwarder.dll' or&#xD;&#xA;                 '%(Filename)%(Extension)' == 'System.Printing.dll' or&#xD;&#xA;                 '%(Filename)%(Extension)' == 'ijwhost.dll'" ExcludeFromSingleFile="true" />
		</ItemGroup>
	</Target>
</Project>