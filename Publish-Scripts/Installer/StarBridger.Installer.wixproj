<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion)</DefineConstants>
    <OutputName>StarBridger-win-x64</OutputName>
    <Cultures>en-US</Cultures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <!-- Generated by Generate-WixComponents.ps1 from the assembled distribution. -->
    <Compile Include="obj/GeneratedFiles.wxs" />
  </ItemGroup>
</Project>
